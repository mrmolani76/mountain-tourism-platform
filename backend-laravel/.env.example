APP_NAME="Mountain Tourism"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Nexro-style local: {slug}.mtmp.local (see docs/LOCAL_MTMP_SETUP.md)
APP_URL=http://demo.mtmp.local:8000
APP_BASE_DOMAIN=mtmp.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mountain_tourism
DB_USERNAME=mt_app
DB_PASSWORD=devpass

# Nuxt SPA origin (CORS + Sanctum stateful)
FRONTEND_URL=http://demo.mtmp.local:3000
SANCTUM_STATEFUL_DOMAINS=mtmp.local,mtmp.local:3000,saas.mtmp.local,saas.mtmp.local:3000,demo.mtmp.local,demo.mtmp.local:3000,lab.mtmp.local,lab.mtmp.local:3000,localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,lab.localhost,lab.localhost:3000,saas.localhost,saas.localhost:3000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Empty = host-only cookie (Inventory / Nexro pattern: no cross-subdomain session leak)
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Central SaaS hosts only (not demo.mtmp.local — that is a tenant host)
TENANCY_CENTRAL_HOSTS=saas.mtmp.local
CENTRAL_DOMAIN=saas.mtmp.local

# Optional: override system hosts path for `php artisan hosts:sync` (default /etc/hosts)
# HOSTS_PATH=

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="Mountain Tourism"
