APP_NAME="Mountain Tourism"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lab.localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mountain_tourism
DB_USERNAME=mt_app
DB_PASSWORD=devpass

# Nuxt SPA origin (CORS + Sanctum stateful)
FRONTEND_URL=http://lab.localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,lab.localhost,lab.localhost:3000,saas.localhost,saas.localhost:3000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Empty = host-only cookie (Inventory pattern: no cross-subdomain session leak)
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Central SaaS hosts only (not lab.localhost — that is a tenant host)
TENANCY_CENTRAL_HOSTS=saas.localhost
CENTRAL_DOMAIN=saas.localhost
