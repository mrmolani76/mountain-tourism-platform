# Empty = same-origin /api (Nuxt proxies to Laravel in dev).
# NUXT_PUBLIC_API_BASE_URL=
NUXT_PUBLIC_API_BASE_URL=

ENV=local

# Proxy TCP target only (Nuxt → Laravel). Use 127.0.0.1 so the proxy does not
# hang when *.mtmp.local / *.localhost are missing from /etc/hosts.
# Browser Host (e.g. demo.mtmp.local:3000) is preserved (changeOrigin: false)
# so Laravel still resolves the tenant. See docs/LOCAL_MTMP_SETUP.md.
BACKEND_URL=http://127.0.0.1:8000
