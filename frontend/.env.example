# Empty = same-origin /api (nginx proxies to Laravel). For local Nuxt → Laravel direct:
# NUXT_PUBLIC_API_BASE_URL=http://demo.mtmp.local:8000
NUXT_PUBLIC_API_BASE_URL=

ENV=local

# Used by some legacy composables; prefer NUXT_PUBLIC_API_BASE_URL.
# Preferred host scheme: docs/LOCAL_MTMP_SETUP.md ({slug}.mtmp.local)
BACKEND_URL=http://demo.mtmp.local:8000
